# Copy to .env for local runs. Never commit .env.
# Every variable is GHAPI_*; an unknown GHAPI_* variable is a startup error, so a typo
# fails loudly. (Not GITHUB_API_*: Actions runners export GITHUB_API_URL into every job.)

GHAPI_ENVIRONMENT=local
GHAPI_LOG_FORMAT=console
# GHAPI_HOST=127.0.0.1
# GHAPI_PORT=8011

# --- Who may call: keyring tokens minted for this audience ---------------------------
GHAPI_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
GHAPI_KEYRING_ISSUER=http://127.0.0.1:8001
GHAPI_AUDIENCE=github-api

# --- The caller's GitHub credential, from keyring's internal surface -----------------
GHAPI_KEYRING_BASE_URL=http://127.0.0.1:8001
# This service's own token: the value keyring holds for "github-api" in
# KEYRING_SERVICE_TOKENS. At least 32 characters. Required.
GHAPI_KEYRING_SERVICE_TOKEN=
# The connection name in keyring (the `service` of its providers.json entry).
# GHAPI_KEYRING_CREDENTIAL_SERVICE=github
# GHAPI_CREDENTIAL_REFRESH_MARGIN_SECONDS=60
# GHAPI_CREDENTIAL_CACHE_SECONDS=300
# GHAPI_CREDENTIAL_CACHE_ENTRIES=1024

# --- GitHub ---------------------------------------------------------------------------
# GHAPI_GITHUB_BASE_URL=https://api.github.com
# GHAPI_GITHUB_GRAPHQL_URL=https://api.github.com/graphql
# GHAPI_REQUEST_TIMEOUT_SECONDS=15
# GHAPI_LOG_LINES_MAX=500
# GHAPI_FILE_CHARS_MAX=100000
# GHAPI_TREE_ENTRIES_MAX=1000
# GHAPI_PATCH_CHARS_MAX=6000

# --- Subscriptions and signals --------------------------------------------------------
GHAPI_DATABASE_PATH=var/github-api.sqlite3
# GHAPI_POLL_SECONDS=60            # 0 turns the background poller off
# GHAPI_SUBSCRIPTION_DEFAULT_SECONDS=3600
# GHAPI_SUBSCRIPTION_MAX_SECONDS=604800
# GHAPI_SUBSCRIPTIONS_PER_ACCOUNT=50
# GHAPI_SUBSCRIPTION_RETENTION_SECONDS=604800
# GHAPI_CREDENTIAL_HOLD_SECONDS=3600
# Signal URLs this service may POST to; empty allows any http(s) URL. JSON list.
# GHAPI_SIGNAL_URL_PREFIXES=["http://127.0.0.1:8000/v1/signals/"]
# GHAPI_SIGNAL_TIMEOUT_SECONDS=10
